{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test:e2e": "tsx test_e2e_suite.ts",
    "test:v1.1": "tsx test_v1_1_suite.ts",
    "test:enterprise": "tsx test_enterprise_suite.ts",
    "test:migration": "tsx test_migration_suite.ts",
    "test:workforce": "tsx test_workforce_suite.ts",
    "test:control-tower": "tsx test_control_tower_suite.ts",
    "test:project-master": "tsx test_project_master_suite.ts",
    "test:uat": "tsx test_uat_suite.ts",
    "test:load": "tsx test_load_performance.ts",
    "test:v1.4.1": "tsx test_v1_4_1_hardening_suite.ts",
    "test:staging-load": "tsx test_staging_load.ts",
    "test:all": "tsx test_migration_suite.ts && tsx test_e2e_suite.ts && tsx test_v1_1_suite.ts && tsx test_enterprise_suite.ts && tsx test_workforce_suite.ts && tsx test_control_tower_suite.ts && tsx test_project_master_suite.ts && tsx test_uat_suite.ts && tsx test_load_performance.ts && tsx test_v1_4_1_hardening_suite.ts",
    "test": "npm run test:all",
    "backup": "tsx scripts/backup_sqlite.ts",
    "backup:verify": "tsx scripts/backup_sqlite.ts --verify",
    "db:clean": "tsx scripts/reset_clean_db.ts",
    "db:reset": "tsx scripts/reset_clean_db.ts",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:build:android": "node scripts/build_android.cjs",
    "mobile:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.2",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
