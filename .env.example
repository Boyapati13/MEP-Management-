# MEP Management Platform Environment Configuration

# Server
PORT=3000
NODE_ENV=production

# Database (defaults to mep_pm.db in project root or /data in Docker)
MEP_DB_PATH=/data/mep_pm.db

# AI Advisor (Google Gemini API Key)
GEMINI_API_KEY=

# Optional: Firebase Authentication
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Shared with the Octo collector; generate with: openssl rand -hex 32
OCTO_INGEST_TOKEN=
# Explicit comma-separated WhatsApp group IDs (120...@g.us)
WHATSAPP_GROUP_IDS=
